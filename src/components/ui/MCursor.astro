---
/** A multiplayer cursor with a name tag, as in the Figma file (decoration). */
interface Props {
  who: 'you' | 'mentor' | 'mate';
  label: string;
}
const { who, label } = Astro.props;
---

<span class:list={['mcursor', `mcursor--${who}`]} aria-hidden="true">
  <svg viewBox="0 0 17 18"><path d="M0.5 0.5 16 6.6 9.2 9.4 6.4 17.2Z"></path></svg>
  <span>{label}</span>
</span>
